# Copy to backend/.env (git-ignored) and fill in. This file holds names only: never put a value here.
# An empty value means "use the default".

# OpenAI key of the dedicated project. Required when IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
# Image provider: stub or openai. Default: stub.
IMAGE_PROVIDER=
# Stub only: every stub call fails with this error kind (refused, quota, rate_limited, timeout, provider_error,
# invalid_request, invalid_response, auth). Refused when IMAGE_PROVIDER=openai. Default: no failure.
STUB_FAIL=
# OpenAI image model name.
OPENAI_IMAGE_MODEL=
# OpenAI image quality.
OPENAI_IMAGE_QUALITY=
# Spend cap in USD. Required, > 0. Without it nothing starts.
SPEND_CAP_USD=
# Date (YYYY-MM-DD, not after today UTC) from which spend counts against the cap. Required.
SPEND_CAP_SINCE=
# Estimated USD cost reserved per scene call. Default: 0.40.
ESTIMATE_SCENE_USD=
# Estimated USD cost reserved per background call. Default: 0.30.
ESTIMATE_BACKGROUND_USD=
# Scene attempts per variant, >= 1. Default: 3.
ATTEMPT_LIMIT=
# Product height as a fraction of the visual height. Default: 0.40.
PRODUCT_HEIGHT_RATIO=
# Photos with a shorter edge below this many pixels get a low-resolution warning. Default: 800.
MIN_SOURCE_SHORT_EDGE=
# Cutout holes smaller than this fraction of the product area are filled, 0 < x < 1. Default: 0.05.
MAX_HOLE_RATIO=
# rembg model name, chosen from the installed rembg version's list (a local model; downloaded once). Default:
# birefnet-general-lite.
REMBG_MODEL=
# Data folder (SQLite DB and assets). Relative paths are from backend/. Default: data.
DATA_DIR=
# HTTP server only: exact browser origin, e.g. http://localhost:5173 in local development.
# HTTPS required except localhost/loopback. No trailing slash or path.
APP_ORIGIN=
# HTTP server only, optional: an Argon2 hash, never a plaintext password. Read at the first start after migration
# 0013 only, as shop 1's (originalphone) password; later starts ignore it. Passwords: python -m affiche.shops.
SHOP_PASSWORD_HASH=
# HTTP server only, optional, at most 200 characters: whom to call for a forgotten password, shown under the sign-in
# form (« Mot de passe oublié ? Contactez … »). Default: not shown.
SUPPORT_CONTACT_FR=
# Each shop's provider spend per UTC day in USD, counted on the day a reservation is admitted, > 0. Default: 2.00.
SHOP_DAILY_SPEND_USD=
# Optional scene/text planning. disabled (default), stub for offline tests, or claude.
PLANNER_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Conservative reservations per Claude plan/patch and per generated text texture.
ESTIMATE_PLAN_USD=
ESTIMATE_TEXTURE_USD=
# Reservation per message read by Claude in the chat (creation by message). Default: 0.02.
ESTIMATE_READ_USD=
# Poster formats a poster may be created in, changed to and exported in: a comma list of feed, square, story.
# Must include feed (every new poster starts in it). Default: feed. Square and Story stay off until real scenes in
# them were judged (T-FMT-007).
FORMATS_ENABLED=
# Publishing on the shop's Facebook Page: off, stub for tests and local work, or meta (only once the Meta app is
# published; deploy/README.md). Default: off.
FACEBOOK_PROVIDER=
# The Meta app's id. Required when FACEBOOK_PROVIDER=meta.
FACEBOOK_APP_ID=
# The Meta app's secret, printable ASCII. Required when FACEBOOK_PROVIDER=meta.
FACEBOOK_APP_SECRET=
