# Copy to backend/.env (git-ignored) and fill in. This file holds names only: never put a value here.
# An empty value means "use the default".

# OpenAI key of the dedicated project. Required when IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
# Image provider: stub or openai. Default: stub.
IMAGE_PROVIDER=
# Stub only: every stub call fails with this error kind (refused, quota, rate_limited, timeout, provider_error,
# invalid_request, invalid_response, auth). Refused when IMAGE_PROVIDER=openai. Default: no failure.
STUB_FAIL=
# OpenAI image model name.
OPENAI_IMAGE_MODEL=
# OpenAI image quality.
OPENAI_IMAGE_QUALITY=
# Spend cap in USD. Required, > 0. Without it nothing starts.
SPEND_CAP_USD=
# Date (YYYY-MM-DD, not after today UTC) from which spend counts against the cap. Required.
SPEND_CAP_SINCE=
# Estimated USD cost reserved per scene call. Default: 0.40.
ESTIMATE_SCENE_USD=
# Estimated USD cost reserved per background call. Default: 0.30.
ESTIMATE_BACKGROUND_USD=
# Scene attempts per variant, >= 1. Default: 3.
ATTEMPT_LIMIT=
# Product height as a fraction of the visual height. Default: 0.40.
PRODUCT_HEIGHT_RATIO=
# Photos with a shorter edge below this many pixels get a low-resolution warning. Default: 800.
MIN_SOURCE_SHORT_EDGE=
# Cutout holes smaller than this fraction of the product area are filled. Default: 0.05.
MAX_HOLE_RATIO=
# rembg model name, chosen from the installed rembg version's list.
REMBG_MODEL=
# Data folder (SQLite DB and assets). Relative paths are from backend/. Default: data.
DATA_DIR=
# Phase 2: API access token.
API_TOKEN=
